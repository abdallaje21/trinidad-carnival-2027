---
// src/pages/success.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Submission Staged - Trinidad Carnival 2027">
  <main class="flex-grow flex flex-col items-center justify-center text-center max-w-xl mx-auto px-4 py-16">
    <div class="w-16 h-16 rounded-full bg-green-50 text-green-500 flex items-center justify-center font-bold text-2xl mb-4 border border-green-200 shadow-xs">✓</div>
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Submission Staged Successfully</h1>
    <p class="text-gray-500 mt-2">The fete details have entered your isolated verification staging review queue safely. Review your dashboard panel layout sheet to authorize public activation!</p>
    <a href="/" class="mt-6 px-5 py-2.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 text-xs font-bold text-gray-700 shadow-xs transition-colors">← Return to Directory Home</a>
  </main>
</BaseLayout>
