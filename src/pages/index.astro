---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import EventFilters from '../components/EventFilters.astro';
import EventCalendar from '../components/EventCalendar.astro';
import eventData from '../data/events.json';

const sortedEvents = eventData.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
---

<BaseLayout title="WE OUT DAY. — Trinidad Carnival 2027 Event Directory">
  <header class="bg-black border-b border-neutral-800 py-5">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      
      <!-- Left Side: Custom Gold Calendar SVG + Side-by-Side Wordmark -->
      <div class="flex flex-col items-start">
        <a href="/" class="inline-flex items-center gap-4 group">
          <!-- Exact Replica Gold Calendar Icon SVG -->
          <svg class="w-11 h-12 sm:w-12 sm:h-14 text-[#FFD100] shrink-0" viewBox="0 0 64 72" fill="none" xmlns="http://w3.org">
            <!-- Top Ring Bindings -->
            <rect x="18" y="4" width="5" height="12" rx="2.5" fill="currentColor" />
            <rect x="41" y="4" width="5" height="12" rx="2.5" fill="currentColor" />
            <!-- Outer Calendar Frame -->
            <rect x="6" y="10" width="52" height="56" rx="6" stroke="currentColor" stroke-width="5" />
            <!-- Header Divider Line -->
            <line x1="6" y1="24" x2="58" y2="24" stroke="currentColor" stroke-width="5" />
            <!-- 3x3 Date Grid Squares -->
            <rect x="14" y="31" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
            <rect x="27.5" y="31" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
            <rect x="41" y="31" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
            <rect x="14" y="42" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
            <rect x="27.5" y="42" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
            <rect x="41" y="42" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
            <rect x="14" y="53" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
            <rect x="27.5" y="53" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
            <rect x="41" y="53" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="3" />
          </svg>

          <!-- Side-by-Side Multi-Colored Wordmark -->
          <span class="text-2xl sm:text-3xl font-black uppercase tracking-[0.16em] sm:tracking-[0.22em] leading-none">
            <span class="text-[#E52521]">WE</span>
            <span class="text-[#00873E] ml-2 sm:ml-2.5">OUT</span>
            <span class="text-[#0055FF] ml-2 sm:ml-2.5">DAY<span class="text-[#FFD100]">.</span></span>
          </span>
        </a>
        <p class="text-neutral-400 text-xs sm:text-sm mt-2">
          Trinidad Carnival 2027 — The simple, one-stop directory for every fete and event.
        </p>
      </div>

      <!-- Right Side: Header Actions & Layout Switcher -->
      <div class="flex flex-wrap items-center gap-3 self-start sm:self-center">
        <a 
          href="/add-event" 
          class="px-4 py-2 rounded-lg bg-[#FFD100] hover:bg-yellow-400 text-black text-xs font-extrabold uppercase tracking-wider shadow-xs transition-colors"
        >
          + Submit an Event
        </a>

        <div class="inline-flex rounded-lg border border-neutral-800 bg-neutral-900 p-1">
          <button id="toggle-directory" class="px-4 py-1.5 text-xs font-semibold rounded-md bg-white text-black shadow-xs transition-all">
            Directory View
          </button>
          <button id="toggle-calendar" class="px-4 py-1.5 text-xs font-semibold rounded-md text-neutral-400 hover:text-white transition-all">
            Calendar View
          </button>
        </div>
      </div>

    </div>
  </header>

  <main class="flex-grow max-w-7xl mx-auto px-4 w-full py-8">
    <!-- View 1: Card List View with Filtering -->
    <div id="directory-view-pane">
      <EventFilters events={sortedEvents}>
        {sortedEvents.map((event) => (
          <EventCard event={event} />
        ))}
      </EventFilters>
    </div>

    <!-- View 2: Grouped Matrix Grid View -->
    <div id="calendar-view-pane" class="hidden">
      <EventCalendar events={sortedEvents} />
    </div>
  </main>

  <script>
    const btnDir = document.getElementById('toggle-directory');
    const btnCal = document.getElementById('toggle-calendar');
    const paneDir = document.getElementById('directory-view-pane');
    const paneCal = document.getElementById('calendar-view-pane');

    if (btnDir && btnCal && paneDir && paneCal) {
      btnDir.addEventListener('click', () => {
        paneDir.classList.remove('hidden');
        paneCal.classList.add('hidden');
        btnDir.classList.add('bg-white', 'text-gray-900', 'shadow-xs');
        btnDir.classList.remove('text-gray-500');
        btnCal.classList.remove('bg-white', 'text-gray-900', 'shadow-xs');
        btnCal.classList.add('text-gray-500');
      });

      btnCal.addEventListener('click', () => {
        paneCal.classList.remove('hidden');
        paneDir.classList.add('hidden');
        btnCal.classList.add('bg-white', 'text-gray-900', 'shadow-xs');
        btnCal.classList.remove('text-gray-500');
        btnDir.classList.remove('bg-white', 'text-gray-900', 'shadow-xs');
        btnDir.classList.add('text-gray-500');
      });
    }
  </script>
</BaseLayout>
