---
// src/pages/add-event.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Submit Your Fete - Trinidad Carnival 2027">
  <header class="bg-white border-b border-gray-100 py-6 shadow-xs">
    <div class="max-w-3xl mx-auto px-4">
      <a href="/" class="text-xs font-bold text-purple-600 hover:text-purple-800 transition-colors flex items-center gap-1 mb-2">
        ← Back to Directory Overview
      </a>
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Submit Your Fete Listing</h1>
      <p class="text-gray-500 mt-1">Add your event parameters below. All submissions enter a verification review staging queue before going public.</p>
    </div>
  </header>

  <main class="flex-grow max-w-3xl mx-auto px-4 w-full py-8">
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 sm:p-8">
      
            <!-- Interactive Forms Detection Form -->
      <form 
        action="https://formspree.io/f/xnpdndda" 
        method="POST" 
        class="space-y-6"
      >
      <input type="hidden" name="_next" value="https://trinidad-carnival-2027.vercel.app/success" />




        <!-- Field 1: Event Name -->
        <div>
          <label for="fete-name" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Event Title Name</label>
          <input type="text" id="fete-name" name="name" required placeholder="e.g. TRIBE Ignite 2027" class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm text-gray-900 focus:outline-hidden focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
        </div>

        <!-- Field 2: Date & Start Time Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="fete-date" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Event Date</label>
            <input type="date" id="fete-date" name="date" min="2027-01-01" max="2027-02-28" required class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm text-gray-900 focus:outline-hidden focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
          </div>
          <div>
            <label for="fete-time" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Doors Open Start Time</label>
            <input type="text" id="fete-time" name="startTime" required placeholder="e.g. 10:00 PM - 4:00 AM" class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm text-gray-900 focus:outline-hidden focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
          </div>
        </div>

        <!-- Field 3: Category Type & Regional Options -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="fete-type" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Fete Classification Type</label>
            <select id="fete-type" name="type" required class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm text-gray-900 focus:outline-hidden focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all bg-white">
              <option value="Fete">Standard Fete</option>
              <option value="Cooler Fete">Cooler Fete</option>
              <option value="Breakfast Fete">Breakfast Fete</option>
              <option value="All-Inclusive">All-Inclusive Premium</option>
              <option value="Boat Cruise">Boat Cruise / Yacht Ride</option>
            </select>
          </div>
          <div>
            <label for="fete-region" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Trinidad Regional Vector</label>
            <select id="fete-region" name="region" required class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm text-gray-900 focus:outline-hidden focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all bg-white">
              <option value="North">North (POS, Woodbrook, Moka)</option>
              <option value="West">West (Chaguaramas, Diego Martin)</option>
              <option value="East">East (Macoya, Arima, Valsayn)</option>
              <option value="South">South (San Fernando, Debe)</option>
            </select>
          </div>
        </div>

        <!-- Field 4: Venue Location Address -->
        <div>
          <label for="fete-location" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Venue Location Address</label>
          <input type="text" id="fete-location" name="location" required placeholder="e.g. Queen's Park Savannah, Port of Spain" class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm text-gray-900 focus:outline-hidden focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
        </div>

        <!-- Field 5: Ticket URL Link Purchase Endpoint -->
        <div>
          <label for="fete-url" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Official Purchase Ticket URL Link</label>
          <input type="url" id="fete-url" name="ticketUrl" required placeholder="https://islandetickets.com..." class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm text-gray-900 focus:outline-hidden focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
        </div>

        <!-- Submission Trigger Buttons -->
        <div class="pt-4 border-t border-gray-100 flex justify-end">
          <button type="submit" class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-sm tracking-wide shadow-md transition-all transform active:scale-98">
            Submit to Verification Queue
          </button>
        </div>
      </form>

    </div>
  </main>
</BaseLayout>
